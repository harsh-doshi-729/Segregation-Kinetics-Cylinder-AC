# This is a matplotlib style sheet that stores the values of rcParams that can be read to style plots

# Text styles:
axes.titlesize: 18 # 26
axes.titleweight: bold
axes.labelsize: 16 # 24
axes.labelweight: bold
font.weight: bold
font.family: Helvetica
axes.formatter.use_mathtext: True
axes.formatter.limits: -2, 3

# Plotting lines:
axes.linewidth: 1

# Axes:
axes.prop_cycle : cycler(color=[ "blue", "BB2D2D", "darkgreen", 'A701A7', 'black'])

# Grid:
# axes.grid: True
# grid.alpha: 0.7
# grid.linewidth: 1.6 # 0.6
# grid.linestyle: --

# Legend:
legend.fontsize: 12 # 20
legend.markerscale: 2

# General line and marker properties:
# lines.linewidth: 2
# lines.marker:
# lines.markersize: 15
# lines.markerfacecolor:

# Ticks:
xtick.labelsize: 16 # 24

ytick.labelsize: 16 # 24



# Figure:
figure.figsize: 16, 9
figure.titleweight: bold
figure.titlesize: 20 # 28
figure.labelweight: bold
figure.labelsize: 18 # 26
# figure.constrained_layout.hspace: 0.2
figure.autolayout: True

# Scatter plot:
lines.markersize: 10

# Box plot:
boxplot.vertical: True
boxplot.whiskers: 1.5
boxplot.showmeans: True
boxplot.meanprops.marker: D # diamond
boxplot.meanprops.markerfacecolor: orange
boxplot.meanprops.markeredgecolor: black
# Size properties:
boxplot.boxprops.linewidth: 2
boxplot.whiskerprops.linewidth: 2
boxplot.capprops.linewidth: 2
boxplot.medianprops.linewidth: 2
boxplot.flierprops.markeredgewidth: 2
boxplot.flierprops.markersize: 10
